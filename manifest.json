{
    "manifest_version": 3,
    "name": "Rating Helper — Калькулятор БРС",
    "version": "1.2.0",
    "description": "Калькулятор балльно-рейтинговой системы БРС, планирование оценок, обмен материалами и отзывы.",
    "action": {
        "default_popup": "popup.html",
        "default_title": "Rating Helper"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "https://online.susu.ru/*",
        "https://*.supabase.co/*",
        "https://api.groq.com/*",
        "https://script.google.com/*",
        "https://script.googleusercontent.com/*",
        "https://drive.google.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://online.susu.ru/*"
            ],
            "js": [ "supabase.js", "contentScript.js" ]
        }
    ],
    "background": {
        "service_worker": "background.js"
    }
}
